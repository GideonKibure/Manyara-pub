{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manyara Pub",
  "version": "1.0.0",
  "identifier": "com.manyara.pub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Manyara Pub",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Inventory, sales, COGS, and backups for Manyara Pub.",
    "longDescription": "Record stock, sales, bills, expenses, and COGS on this computer. Sign in with an existing account to restore cloud backups on another device.",
    "copyright": "Manyara Pub",
    "category": "Business",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    }
  }
}
